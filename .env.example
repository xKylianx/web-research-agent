# Search Provider Configuration
# Options: tavily (default), serpapi, brave
SEARCH_PROVIDER=tavily

# Tavily API (recommended for AI agents)
# Get your key at: https://app.tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# SerpAPI (alternative - Google Search)
# Get your key at: https://serpapi.com/
# SERPAPI_API_KEY=your_serpapi_key_here

# Brave Search API (alternative)
# Get your key at: https://brave.com/search/api/
# BRAVE_SEARCH_API_KEY=your_brave_key_here

# LLM Provider Configuration
# Options: openai, anthropic, ollama
LLM_PROVIDER=openai

# OpenAI API (for report synthesis)
# Get your key at: https://platform.openai.com/
OPENAI_API_KEY=your_openai_key_here

# Anthropic API (alternative LLM)
# Get your key at: https://console.anthropic.com/
# ANTHROPIC_API_KEY=your_anthropic_key_here

# Ollama (local LLM - no API key needed)
# OLLAMA_BASE_URL=http://localhost:11434

# Agent Configuration
MAX_RESULTS=30
MAX_SOURCES=10
EMBEDDING_MODEL=all-MiniLM-L6-v2
